--- !u!114 &660124250
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 660124249}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c75237bba6dd854e838583a8ea48218, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Mira
        icon: {fileID: 3908053973877089684, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 1
      line: Finally... I can go home.
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Reynaldo
        icon: {fileID: 6856890593810730234, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 0
      line: Go home?
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Reynaldo
        icon: {fileID: 6856890593810730234, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 0
      line: The graduation isn't over.
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Reynaldo
        icon: {fileID: 6856890593810730234, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 0
      line: Every year, they get to celebrate their graduation... while I never got
        mine.
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Reynaldo
        icon: {fileID: 6856890593810730234, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 0
      line: Their families moved on. Their descendants lived their lives. But I was
        left here.
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Reynaldo
        icon: {fileID: 6856890593810730234, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 0
      line: And now, it's your turn.
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Mira
        icon: {fileID: 3908053973877089684, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 1
      line: You... You were never trying to help me escape?
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Reynaldo
        icon: {fileID: 6856890593810730234, guid: bdb16b0c772aa1d4a92bfb75ff475147, type: 3}
        isPlayer: 0
      line: Welcome to your final examination, Mira.
      hasImage: 0
      fullscreenImage: {fileID: 0}
  disableAfterDialogue: 1
  isDialogueOnInteract: 0
  Alert: {fileID: 0}
  audioToStop: {fileID: 0}
  startQuestAfterDialogue: 0
