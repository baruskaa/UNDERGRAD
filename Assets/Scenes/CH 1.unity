    - character:
        name: Luz
        icon: {fileID: 21300000, guid: 70510fe6c25f9384e95303ac2610866f, type: 3}
        isPlayer: 1
      line: 'Holabellz.... May kwento akiskiz... '
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Amity
        icon: {fileID: 21300000, guid: ee73a6769cd63564997ab101287c509f, type: 3}
        isPlayer: 0
      line: Dear Teacheraka, kamustasa kalabasa? Keri ka lang ba?
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Luz
        icon: {fileID: 21300000, guid: 70510fe6c25f9384e95303ac2610866f, type: 3}
        isPlayer: 1
      line: Gorabellz ang lola nyey sa nyinistop para magbuyla-mezlu ng mga nyoging!!!
      hasImage: 0
      fullscreenImage: {fileID: 0}
    - character:
        name: Amity
        icon: {fileID: 21300000, guid: ee73a6769cd63564997ab101287c509f, type: 3}
        isPlayer: 0
      line: Bet kong ipagsabi sayels na wititit makakajosok sa iskulembang si junakis
        ngayonchi.
      hasImage: 0
      fullscreenImage: {fileID: 0}
  disableAfterDialogue: 1
  isDialogueOnInteract: 1
